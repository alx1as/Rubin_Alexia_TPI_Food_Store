# Para usar PostgreSQL (recomendado para entrega):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db
# Desarrollo sin PostgreSQL: DATABASE_URL=sqlite:///./foodstore.db
SECRET_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
# false para localhost HTTP; true al publicar con HTTPS.
COOKIE_SECURE=false
